# ===== 复制本文件为 .env 并填入你的密钥 =====

# DeepSeek 对话模型
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 智谱 GLM Embedding（向量化）
ZHIPU_API_KEY=xxxxxxxxxxxxxxxx
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=embedding-3
# 向量维度（embedding-3 支持 256/512/1024/2048，需与 Milvus 集合维度一致）
EMBED_DIM=1024

# Milvus
MILVUS_ADDR=localhost:19530
MILVUS_COLLECTION=user_profiles

# PostgreSQL（用户/会话/消息/日记）
DATABASE_URL=postgres://ntmu:ntmupass@localhost:5433/ntmu

# HTTP 服务
SERVER_ADDR=:8080

# 画像提取 worker 并发数（Go goroutine 池大小）
EXTRACT_WORKERS=4
